<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="History"
        android:textColor="@color/brown_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_pill_selected"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipTelebirr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telebirr"
            android:textColor="@color/brown_text"
            android:textSize="13sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_pill_stroke"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipCbe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CBE"
            android:textColor="@color/brown_text"
            android:textSize="13sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_pill_stroke"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/historyEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nothing here yet."
        android:textColor="@color/brown_text_soft"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

</LinearLayout>
